<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Version>$(War3NetCodeAnalysisVersion)</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Description>War3Net.CodeAnalysis contains additional parsers for the Pidgin parsing library.</Description>
		<PackageTags>parser;warcraft3</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)'=='Debug'">
		<ProjectReference Include="..\..\submodules\Pidgin\Pidgin\Pidgin.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<PackageReference Include="Pidgin" Version="3.1.0" />
	</ItemGroup>

</Project>
